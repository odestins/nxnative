{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "switch-guest-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {"DISCORD_APPLICATION_ID": "1560449870496792729"},
  "ratelimits": [
    {"name": "IP_LIMIT", "namespace_id": "1001", "simple": {"limit": 10, "period": 60}},
    {"name": "IDENTITY_LIMIT", "namespace_id": "1002", "simple": {"limit": 3, "period": 60}},
    {"name": "EDGE_LIMIT", "namespace_id": "1003", "simple": {"limit": 100, "period": 60}}
  ],
  "observability": {"enabled": true, "head_sampling_rate": 0.1}
}
